{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Automerge Updates in Dockerfile",
      "matchManagers": ["dockerfile"],
      "automerge": true
    },
    {
      "description": "Linuxserver.io Packaging Versioning (lsXXX as build, no revision)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/**"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
  ]
}
